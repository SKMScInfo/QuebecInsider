\f2\fs18 {\listtext	\uc0\u8226 	}
\f1\fs26     .AddSqlServer(builder.Configuration.GetConnectionString("DefaultConnection"), name: "Base de donn\'e9es")\
\ls66\ilvl0
\f2\fs18 {\listtext	\uc0\u8226 	}
\f1\fs26     .AddCheck<MonServicePersonnaliseHealthCheck>("Service Externe");\
\ls66\ilvl0
\f2\fs18 {\listtext	\uc0\u8226 	}
\f1\fs26 \
\ls66\ilvl0
\f2\fs18 {\listtext	\uc0\u8226 	}
