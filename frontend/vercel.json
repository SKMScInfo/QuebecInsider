{
  "outputDirectory": "dist/quebec-insider-frontend/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ca-quebecinsider-api.delightfulbeach-019eb41d.westus.azurecontainerapps.io/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/api/ssr"
    }
  ],
  "functions": {
    "api/ssr.mjs": {
      "includeFiles": "dist/quebec-insider-frontend/**"
    }
  }
}
